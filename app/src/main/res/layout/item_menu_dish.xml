<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivMenuDish"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvMenuDishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dish Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvMenuDishCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="North Indian • Lunch"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvMenuDishDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delicious home cooked meal..."
                android:textSize="12sp"
                android:textColor="#999999"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMenuDishPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹150"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"/>

                <Button
                    android:id="@+id/btnAddDish"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Add"
                    android:background="@drawable/btn_rounded"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>