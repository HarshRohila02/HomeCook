<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <RelativeLayout
        style="@style/ToolbarStyle"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBackMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Menu"
                style="@style/ToolbarTitle" />

            <TextView
                android:id="@+id/tvCookNameMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by Priya Sharma"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="20dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterMenuAll"
                style="@style/CategoryChip"
                android:text="All" />
            <Button
                android:id="@+id/filterMenuBreakfast"
                style="@style/CategoryChip"
                android:text="Breakfast" />
            <Button
                android:id="@+id/filterMenuLunch"
                style="@style/CategoryChip"
                android:text="Lunch" />
            <Button
                android:id="@+id/filterMenuDinner"
                style="@style/CategoryChip"
                android:text="Dinner" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Menu List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCookMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <!-- Bottom Cart Summary -->
    <RelativeLayout
        android:id="@+id/layoutCartSummary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_button_primary"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCartItemsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="2 Items in Cart"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="View Cart →"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />
    </RelativeLayout>

</LinearLayout>
