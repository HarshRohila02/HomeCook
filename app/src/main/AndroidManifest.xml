<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeCook">

        <activity
            android:name=".activities.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.auth.LoginActivity" />
        <activity android:name=".activities.auth.SignUpActivity" />
        <activity android:name=".activities.auth.SetupProfileActivity" />
        <activity android:name=".HomeActivity" />

        <!-- Real Activities -->
        <activity android:name=".activities.CartActivity" />
        <activity android:name=".activities.SearchActivity" />
        <activity android:name=".activities.ReviewsActivity" />
        <activity android:name=".activities.ReferralActivity" />
        <activity android:name=".activities.SettingsActivity" />

        <activity android:name=".activities.CookProfileActivity" />
        <activity android:name=".activities.DishDetailActivity" />
        <activity android:name=".activities.CookMenuActivity" />
        <activity android:name=".activities.ProfileActivity" />
        <activity android:name=".activities.EditProfileActivity" />
        <activity android:name=".activities.SavedAddressActivity" />

        <activity android:name=".activities.NotificationsActivity" />
        <activity android:name=".activities.OrdersActivity" />
        <activity android:name=".activities.HelpSupportActivity" />

        <!-- Order Flow -->
        <activity android:name=".activities.OrderCheckoutActivity" />
        <activity android:name=".activities.OrderTrackingActivity" />
        <activity android:name=".activities.OrderPaymentSuccessActivity" />

        <!-- Subscription Flow -->
        <activity android:name=".activities.SubscriptionPlansActivity" />
        <activity android:name=".activities.MySubscriptionsActivity" />
        <activity android:name=".activities.SubscriptionCheckoutActivity" />
        <activity android:name=".activities.SubscriptionPaymentSuccessActivity" />

        <activity android:name=".activities.CookListActivity" />

    </application>

</manifest>